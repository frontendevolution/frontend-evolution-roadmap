# ─────────────────────────────────────────────────────────────
# Email provider credentials — uncomment the block matching your
# provider in app/api/subscribe/route.ts, then fill in the matching
# variables below.
# ─────────────────────────────────────────────────────────────

# ConvertKit
# CONVERTKIT_API_KEY=
# CONVERTKIT_FORM_ID=

# Beehiiv
# BEEHIIV_API_KEY=
# BEEHIIV_PUBLICATION_ID=

# Resend
# RESEND_API_KEY=
# RESEND_AUDIENCE_ID=

# Mailchimp
# MAILCHIMP_API_KEY=
# MAILCHIMP_LIST_ID=
# MAILCHIMP_DC=          # e.g. "us21" — the suffix on your Mailchimp API key

# Supabase
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
